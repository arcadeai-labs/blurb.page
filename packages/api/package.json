    "@json-render/shadcn": "^0.21.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.12.23",
    "postgres": "^3.4.9",
    "run": "^2.1.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@types/node": "^24.12.4",
    "drizzle-kit": "^0.31.11",
    "typescript": "~5.9.3"
